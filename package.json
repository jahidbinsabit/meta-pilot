  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.13",
    "playwright": "^1.44.0",
    "postcss": "^8.4.39",
    "prettier": "^3.2.5",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
