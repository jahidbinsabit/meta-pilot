{
  "name": "genmetaai",
  "version": "1.0.0",
  "private": true,
  "description": "StockForge AI — AI metadata generator for stock-content creators",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "ts-node -r tsconfig-paths/register -O '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.0.13",
    "@aws-sdk/client-s3": "^3.570.0",
    "@aws-sdk/s3-request-presigner": "^3.570.0",
    "@prisma/client": "^5.14.0",
    "@radix-ui/react-dialog": "^1.0.7",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.36.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.16.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.1.1",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.379.0",
    "next": "^14.2.13",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^6.9.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "recharts": "^2.12.7",
    "sharp": "^0.33.5",
    "stripe": "^15.8.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
