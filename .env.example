# =============================================
# StockForge AI — Environment Configuration
# Copy to .env and fill in real values.
# =============================================

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRIAL_CREDITS=20

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/genmetaai"

# --- Auth ---
NEXTAUTH_SECRET="replace-with-64-char-random-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# --- S3-compatible object storage ---
# For local development with MinIO (run ./setup-minio.sh):
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="stockforge-ai"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_FORCE_PATH_STYLE="true"

# For production with AWS S3, use:
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_ACCESS_KEY_ID="AKIA..."
# S3_SECRET_ACCESS_KEY="..."
# S3_FORCE_PATH_STYLE="false"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- AI providers (swappable; active selection stored in DB) ---
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Manual payments (bKash / Nagad) ---
BKASH_APP_KEY="your-bkash-app-key"
BKASH_APP_PASSWORD="your-bkash-app-password"
BKASH_USERNAME="your-bkash-username"
BKASH_PASSWORD="your-bkash-password"
NAGAD_APP_KEY="your-nagad-app-key"
NAGAD_APP_PASSWORD="your-nagad-app-password"
NAGAD_USERNAME="your-nagad-username"
NAGAD_PASSWORD="your-nagad-password"

# --- Credits / membership defaults ---
FREE_CREDITS_DAILY="5"
TRIAL_CREDITS="20"

# --- Email (optional, for auth + receipts) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="app-password"

# --- Adobe Stock API (Adobe Analytics module) ---
# Create an app in the Adobe Developer Console with the "Stock" service and
# copy the API key (Client ID). Search only needs the API key — no OAuth
# token is required for asset metadata or thumbnails.
# Get a key: https://developer.adobe.com/console
ADOBE_STOCK_API_KEY=""
# Sent as the X-Product header; identifies your app to Adobe.
ADOBE_STOCK_PRODUCT="StockForgeAI/1.0"

# --- Misc ---
NODE_ENV="development"
